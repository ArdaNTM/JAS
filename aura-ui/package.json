{
    "name": "aura-ui",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron-main.cjs",
    "scripts": {
        "dev": "vite",
        "desktop": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "desktop:local": "npm run build && cross-env AURA_DESKTOP_MODE=production electron ."
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@tailwindcss/vite": "^4.1.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.0.1",
        "cross-env": "^7.0.3",
        "electron": "^32.3.3",
        "eslint": "^9.9.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^15.9.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.1.0",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.0.1",
        "vite": "^5.4.1",
        "wait-on": "^8.0.1"
    }
}
